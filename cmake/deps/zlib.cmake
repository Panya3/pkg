# zlib — static only, no tests, no install rules of its own.

set(ZLIB_BUILD_SHARED  OFF CACHE BOOL "" FORCE)
set(ZLIB_BUILD_STATIC  ON  CACHE BOOL "" FORCE)
set(ZLIB_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(ZLIB_INSTALL       OFF CACHE BOOL "" FORCE)

add_subdirectory("${PKG_VENDOR_DIR}/zlib" "${CMAKE_BINARY_DIR}/vendor/zlib" EXCLUDE_FROM_ALL)

# The two public headers. zconf.h is generated by zlib's configure_file into its
# own build dir, which exists by the time we get here.
set(_zlib_headers "${PKG_VENDOR_DIR}/zlib/zlib.h")
if(EXISTS "${CMAKE_BINARY_DIR}/vendor/zlib/zconf.h")
    list(APPEND _zlib_headers "${CMAKE_BINARY_DIR}/vendor/zlib/zconf.h")
endif()

pkg_pick_target(_zlib zlibstatic zlib)
pkg_stage(zlib TARGET ${_zlib} HEADER_FILES ${_zlib_headers})
pkg_alias(zlib ${_zlib})
